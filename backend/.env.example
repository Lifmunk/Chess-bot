# Backend Configuration

# App
APP_NAME="Chess Club Bot"
ADMIN_PASSWORD=your-secure-password
ADMIN_TOKEN_SECRET=your-token-secret
ADMIN_TOKEN_TTL_HOURS=168

# Database (MongoDB)
# If using MongoDB Atlas, the URI should look like: mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=chessclub

# AI (Groq)
GROQ_API_KEY=your-groq-api-key

# Discord
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-guild-id
DISCORD_ANNOUNCEMENT_CHANNEL_ID=your-channel-id
DISCORD_RESULTS_CHANNEL_ID=your-channel-id
DISCORD_PUZZLE_CHANNEL_ID=your-channel-id
DISCORD_PLAYERS_ROLE_ID=your-role-id
DISCORD_VERIFIED_ROLE_ID=your-role-id
DISCORD_CHAMPION_ROLE_ID=your-role-id

# Automation
DAILY_PUZZLE_HOUR_UTC=12
DAILY_PUZZLE_MINUTE_UTC=0

# URLs (For CORS and announcements)
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
