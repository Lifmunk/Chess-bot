# --- Chess Club Bot Backend Configuration ---

# Application Settings
APP_NAME="Chess Club Bot"
ADMIN_PASSWORD=your-secure-password
ADMIN_TOKEN_SECRET=your-random-token-secret
ADMIN_TOKEN_TTL_HOURS=168

# Database (MongoDB)
# IMPORTANT: If using Atlas, ensure your IP is allow-listed (0.0.0.0/0 for Render).
# Format: mongodb+srv://<user>:<password>@cluster.mongodb.net/chessclub?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=chessclub

# AI (Groq)
# Get your key from https://console.groq.com/
GROQ_API_KEY=your-groq-api-key

# Discord Bot
# Get token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your-bot-token
DISCORD_GUILD_ID=your-server-id
DISCORD_ANNOUNCEMENT_CHANNEL_ID=your-announcement-channel-id
DISCORD_RESULTS_CHANNEL_ID=your-results-channel-id
DISCORD_PUZZLE_CHANNEL_ID=your-puzzle-channel-id

# Roles (Optional but recommended)
DISCORD_PLAYERS_ROLE_ID=your-players-role-id
DISCORD_VERIFIED_ROLE_ID=your-verified-role-id
DISCORD_CHAMPION_ROLE_ID=your-champion-role-id

# Automation
DAILY_PUZZLE_HOUR_UTC=12
DAILY_PUZZLE_MINUTE_UTC=0

# URLs (For CORS and announcements)
# FRONTEND_URL should be your Vercel URL in production.
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
