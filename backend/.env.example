# Backend Configuration

# --- SECURITY (Required in .env) ---
# The password used to access the admin portal
ADMIN_PASSWORD=change-me
# Secret key for generating session tokens
ADMIN_TOKEN_SECRET=change-this-secret-for-production

# --- INFRASTRUCTURE (Required in .env) ---
# MongoDB connection URI (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=chessclub

# Groq API Key for AI announcements (Get at https://console.groq.com/)
GROQ_API_KEY=gsk_your_key_here

# Discord Bot Token (Get at https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here

# --- OPTIONAL ---
# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*
# Public frontend URL used for CORS when deployed
FRONTEND_URL=
# Public backend URL for links or integrations
BACKEND_PUBLIC_URL=
# App environment: local or deployment
APP_ENV=local
