# --- Chess Club Bot Frontend Configuration ---

# APP_ENV: "local" (default) or "deployment"
# - local: Defaults API URL to http://localhost:8000
# - deployment: Defaults API URL to https://chess-bot-uflt.onrender.com
VITE_APP_ENV=local

# VITE_API_BASE_URL: (Optional) Override the API URL explicitly.
# If not set, it uses the defaults based on VITE_APP_ENV.
# VITE_API_BASE_URL=https://chess-bot-uflt.onrender.com
